# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values belong here:
# they are bundled into the app and are public by design. Never put the
# service role key, R2 keys or any other secret in this file.
#
# local: values printed by `pnpm supabase start` (API URL and anon key).
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local: Supabase Storage stands in for R2, so read photos straight from it.
# (Staging/production: the media Worker URL.)
EXPO_PUBLIC_MEDIA_URL=http://127.0.0.1:54321/storage/v1/object/public/onlyswap-media
EXPO_PUBLIC_SITE_URL=https://onlyswap.pages.dev
# Optional telemetry (public values). Leave empty locally.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
