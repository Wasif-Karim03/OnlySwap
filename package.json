{
  "name": "onlyswap",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "doctor": "pnpm --filter mobile doctor",
    "verify:prebuild": "node scripts/verify/check-prebuild.mjs",
    "prepare": "simple-git-hooks",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "scan:bundle": "node scripts/verify/scan-bundle.mjs",
    "test:scripts": "node --experimental-strip-types --test scripts/rpc-contract.test.ts && node scripts/verify/check-staging-migrations.mjs",
    "rpc:contract": "node --experimental-strip-types scripts/rpc-contract.ts generate",
    "rpc:check": "node --experimental-strip-types scripts/rpc-contract.ts check"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "supabase": "2.118.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/hooks/pre-commit.sh"
  }
}
