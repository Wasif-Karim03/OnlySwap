---
// Simple line drawings of typical dorm items for the phone mockups. Drawn in
// the board's stroke style; not product photos and not stock art.
interface Props {
  kind: 'fridge' | 'lamp' | 'books' | 'chair' | 'bike' | 'guitar';
  size?: number;
}
const { kind, size = 96 } = Astro.props;
---

<svg class="item" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true">
  {
    kind === 'fridge' && (
      <g>
        <rect x="26" y="10" width="44" height="76" rx="7" />
        <path d="M26 40h44M34 22v10M34 50v14" />
      </g>
    )
  }
  {
    kind === 'lamp' && (
      <g>
        <path d="M30 84h36M48 84V52M48 52l-14-18M34 34l20-14 10 14z" />
        <circle cx="62" cy="40" r="3" />
      </g>
    )
  }
  {
    kind === 'books' && (
      <g>
        <rect x="18" y="62" width="60" height="14" rx="3" />
        <rect x="24" y="46" width="52" height="16" rx="3" />
        <rect x="20" y="30" width="54" height="16" rx="3" />
        <path d="M30 30v16M66 46v16M28 62v14" />
      </g>
    )
  }
  {
    kind === 'chair' && (
      <g>
        <path d="M30 16h36v30H30zM26 46h44v10H26zM34 56l-4 28M62 56l4 28M48 56v20" />
      </g>
    )
  }
  {
    kind === 'bike' && (
      <g>
        <circle cx="24" cy="62" r="16" />
        <circle cx="72" cy="62" r="16" />
        <path d="M24 62l14-26h22l12 26M38 36l12 26h-26M60 36l-4-10h-8M44 26h10" />
      </g>
    )
  }
  {
    kind === 'guitar' && (
      <g>
        <path d="M56 40l20-20M72 16l8 8" />
        <path d="M56 40c-6-6-16-4-18 4-2 6-8 4-14 10-8 8-4 22 6 26s20-2 24-10c2-6 0-12 6-14 8-2 10-10 2-16z" />
        <circle cx="40" cy="62" r="5" />
      </g>
    )
  }
</svg>
