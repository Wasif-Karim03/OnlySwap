#!/usr/bin/env bash
# Cloudflare for PRODUCTION (LAUNCH_READINESS items 7, 10, 27, 32, 41), all free.
#   bash scripts/deploy/cloudflare-prod.command
# Run after scripts/deploy/prod-supabase.command (needs .env.production).
# Before the first run (docs/runbooks/production.md):
#   - your domain is on Cloudflare (free plan)
#   - an R2 API token scoped to the buckets onlyswap-media and onlyswap-private
#   - a Turnstile widget for your domain (site key here, secret went to prod-supabase)
# Safe to re-run. Secrets are typed at hidden prompts or read from the Keychain.
# No staging or test value is used anywhere in this script.
cd "$(dirname "$0")/../.." || exit 1
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
set -o pipefail
NAME=onlyswap-prod
STATE=.env.production
LOG=cloudflare-prod.log
MEDIA_BUCKET=onlyswap-media
PRIVATE_BUCKET=onlyswap-private
SITE_PROJECT=onlyswap-prod-site
ADMIN_PROJECT=onlyswap-prod-admin
WEB_PROJECT=onlyswap-prod-web
APPLE_TEAM_ID=L3DN7Y4X67
: > "$LOG"
WR() { npx -y wrangler@4 "$@"; }
SB() { pnpm -s supabase "$@"; }
say() { echo; echo "== $*" | tee -a "$LOG"; }
die() { echo "STOPPED: $*" | tee -a "$LOG"; exit 1; }
kc_get() { security find-generic-password -a "$NAME" -s "$1" -w 2>/dev/null; }
kc_set() { security add-generic-password -U -a "$NAME" -s "$1" -w "$2" >/dev/null; }
[ -f "$STATE" ] || die "run scripts/deploy/prod-supabase.command first"
# shellcheck disable=SC1090
set -a; . "./$STATE"; set +a
REF=$PROD_REF
DOMAIN=$PROD_DOMAIN
SITE_URL=https://$DOMAIN
ADMIN_URL=https://admin.$DOMAIN
WEB_URL=https://app.$DOMAIN
MEDIA_HOST=media.$DOMAIN
MEDIA_URL=https://$MEDIA_HOST
[ -n "$REF" ] && [ -n "$DOMAIN" ] || die "$STATE is missing PROD_REF or PROD_DOMAIN"

say "1/6 Cloudflare login"
WR whoami >/dev/null 2>&1 || WR login || die "login failed"
ACCOUNT_ID=$(WR whoami 2>/dev/null | grep -oE '[0-9a-f]{32}' | head -1)
[ -n "$ACCOUNT_ID" ] || die "no Cloudflare account id"
echo "account: $ACCOUNT_ID (not a secret)" | tee -a "$LOG"

say "2/6 R2 buckets, CORS and the exports lifecycle rule"
for b in "$MEDIA_BUCKET" "$PRIVATE_BUCKET"; do
  out=$(WR r2 bucket create "$b" 2>&1); echo "$out" >> "$LOG"
  echo "$out" | grep -qiE 'created|already exists|already own' || die "bucket $b failed (see $LOG)"
  echo "bucket $b ok"
done
CORS=$(mktemp)
cat > "$CORS" <<EOF
{"rules":[{"allowed":{"origins":["$WEB_URL","$SITE_URL"],"methods":["PUT","GET","HEAD"],"headers":["content-type"]},"maxAgeSeconds":3600}]}
EOF
WR r2 bucket cors set "$MEDIA_BUCKET" --file "$CORS" --force >>"$LOG" 2>&1 && echo "cors ok" || echo "cors: set it in the dashboard (origins $WEB_URL and $SITE_URL only)" | tee -a "$LOG"
rm -f "$CORS"
WR r2 bucket lifecycle add "$PRIVATE_BUCKET" exports-8-days exports/ --expire-days 8 --force >>"$LOG" 2>&1 \
  && echo "lifecycle ok" || echo "lifecycle: may already exist (check $LOG)" | tee -a "$LOG"

say "3/6 Media Worker on $MEDIA_HOST"
# A generated config (git-ignored) adds the custom domain to the default env.
PROD_TOML=workers/media/wrangler.prod.toml
node - "$MEDIA_HOST" <<'NODE'
const fs = require('fs');
const host = process.argv[2];
let t = fs.readFileSync('workers/media/wrangler.toml', 'utf8');
t = t.slice(0, t.indexOf('[env.staging]')).trimEnd();
t = t.replace('workers_dev = true', `workers_dev = false\nroutes = [{ pattern = "${host}", custom_domain = true }]`);
fs.writeFileSync('workers/media/wrangler.prod.toml', `# Generated by scripts/deploy/cloudflare-prod.command (git-ignored).\n${t}\n`);
NODE
printf %s "$(kc_get onlyswap-vault-media_signing_key)" | WR secret put MEDIA_SIGNING_KEY -c "$PROD_TOML" >>"$LOG" 2>&1 \
  || die "worker secret failed (see $LOG)"
WR deploy -c "$PROD_TOML" 2>&1 | tee -a "$LOG" >/dev/null || die "worker deploy failed (is $DOMAIN on this Cloudflare account?)"
echo "media url: $MEDIA_URL" | tee -a "$LOG"

say "4/6 R2 upload keys for the Edge Functions"
AK=$(kc_get onlyswap-r2-access-key-id); SK=$(kc_get onlyswap-r2-secret)
if [ -z "$SK" ]; then
  echo "Paste the PRODUCTION R2 token values (scoped to $MEDIA_BUCKET and $PRIVATE_BUCKET)."
  read -rsp "R2 Access Key ID (hidden): " AK; echo
  read -rsp "R2 Secret Access Key (hidden): " SK; echo
  [ -n "$AK" ] && [ -n "$SK" ] || die "both values are needed"
  kc_set onlyswap-r2-access-key-id "$AK"; kc_set onlyswap-r2-secret "$SK"
fi
SECF=$(mktemp); chmod 600 "$SECF"
cat > "$SECF" <<EOF
R2_ENDPOINT=https://$ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=https://$ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=$AK
R2_SECRET_ACCESS_KEY=$SK
R2_BUCKET_MEDIA=$MEDIA_BUCKET
R2_BUCKET_PRIVATE=$PRIVATE_BUCKET
MEDIA_URL=$MEDIA_URL
EOF
SB secrets set --project-ref "$REF" --env-file "$SECF" >/dev/null 2>>"$LOG"; rc=$?; rm -f "$SECF"
[ $rc -eq 0 ] || die "supabase secrets failed (see $LOG)"
echo "upload keys stored in Supabase secrets"

TS_SITE=$(kc_get onlyswap-turnstile-site-key)
if [ -z "$TS_SITE" ]; then read -rp "Turnstile SITE key for $DOMAIN (public): " TS_SITE; kc_set onlyswap-turnstile-site-key "$TS_SITE"; fi
case "$TS_SITE" in 1x0000*|2x0000*|3x0000*|'') die "production needs the real Turnstile site key";; esac
grep -q '^EXPO_PUBLIC_TURNSTILE_SITE_KEY=' "$STATE" || echo "EXPO_PUBLIC_TURNSTILE_SITE_KEY=$TS_SITE" >> "$STATE"

pages() { # project dir
  WR pages project create "$1" --production-branch main >>"$LOG" 2>&1 || true
  WR pages deploy "$2" --project-name "$1" --branch main --commit-dirty=true 2>&1 | tee -a "$LOG" | grep -E 'https://|Success|rror' || return 1
}

say "5/6 Website ($SITE_URL)"
( cd apps/site && SITE_URL=$SITE_URL APPLE_TEAM_ID=$APPLE_TEAM_ID \
    PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY \
    PUBLIC_TURNSTILE_SITE_KEY=$TS_SITE pnpm -s build ) >>"$LOG" 2>&1 || die "site build failed (see $LOG)"
cat > apps/site/wrangler.toml <<EOF
# Generated by scripts/deploy/cloudflare-prod.command (git-ignored).
name = "$SITE_PROJECT"
pages_build_output_dir = "dist"
compatibility_date = "2026-09-01"
[vars]
SUPABASE_URL = "$EXPO_PUBLIC_SUPABASE_URL"
SUPABASE_ANON_KEY = "$EXPO_PUBLIC_SUPABASE_ANON_KEY"
MEDIA_URL = "$MEDIA_URL"
TURNSTILE_SITE_KEY = "$TS_SITE"
EOF
( cd apps/site && pages "$SITE_PROJECT" dist ) || die "site deploy failed (see $LOG)"

say "6/6 Admin console and web app"
# No VITE_APP_ENV: staging tools stay out of the production console.
( cd apps/admin && VITE_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL VITE_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY \
    VITE_MEDIA_URL=$MEDIA_URL pnpm -s build ) >>"$LOG" 2>&1 || die "admin build failed (see $LOG)"
pages "$ADMIN_PROJECT" apps/admin/dist || die "admin deploy failed"
( cd apps/mobile && EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL \
    EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY EXPO_PUBLIC_MEDIA_URL=$MEDIA_URL \
    EXPO_PUBLIC_SITE_URL=$SITE_URL EXPO_PUBLIC_TURNSTILE_SITE_KEY=$TS_SITE pnpm -s export:web ) >>"$LOG" 2>&1 || die "web app build failed (see $LOG)"
pages "$WEB_PROJECT" apps/mobile/dist || die "web app deploy failed"

say "Custom domains (one time, in the dashboard)"
echo "Workers & Pages > $SITE_PROJECT  > Custom domains > add $DOMAIN"
echo "Workers & Pages > $ADMIN_PROJECT > Custom domains > add admin.$DOMAIN"
echo "Workers & Pages > $WEB_PROJECT   > Custom domains > add app.$DOMAIN"

say "Check"
for u in "$SITE_URL" "$SITE_URL/privacy" "$SITE_URL/delete" "$ADMIN_URL" "$WEB_URL"; do
  echo "$u -> $(curl -s -o /dev/null -w '%{http_code}' "$u")" | tee -a "$LOG"
done
echo "(000 or 522 on the site, admin or app = custom domain not added yet)"
echo "media: open $MEDIA_URL/<a listing photo key> after your first upload"
echo "DONE $(date)" | tee -a "$LOG"
